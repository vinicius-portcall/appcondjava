    <resources>
        <!-- 128x128: mesmo tamanho e mesmos cantos arredondados do bloco que a
             SplashScreen do Flutter desenha em seguida (lib/screens/splash_screen.dart)
             e da tela nativa do Android (android/.../launch_background.xml). As duas
             telas mostram a mesma logo, no mesmo lugar, sobre o mesmo fundo. -->
        <image name="LaunchImage" width="128" height="128"/>
        <!-- Fundo do Scaffold do app (lib/theme/app_colors.dart), com variante
             escura no próprio colorset — sem isso a tela nativa pisca branco
             antes do primeiro frame do Flutter. -->
